{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weblaunch-directory",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-26",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/site/*",
      "/category/*",
      "/sitemap.xml",
      "/feed.xml",
      "/robots.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
