{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weblaunch-directory",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-26",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/site/*",
      "/category/*",
      "/contact",
      "/contact/",
      "/sitemap.xml",
      "/feed.xml",
      "/robots.txt"
    ]
  },
  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "weblaunch-directory-db",
    "database_id": "6318c6a0-b7bb-4d08-980b-7a14067d6be7"
  }
],
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ]
}
