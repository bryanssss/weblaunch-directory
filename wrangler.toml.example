# Optional local-development configuration.
# The dashboard-only setup in SETUP-GUIDE.md does not require this file.
name = "weblaunch-directory"
compatibility_date = "2026-07-25"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DB"
database_name = "weblaunch-directory-db"
database_id = "PASTE-YOUR-D1-DATABASE-ID-HERE"
